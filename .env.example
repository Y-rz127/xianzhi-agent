# ============================================================
# 先知智能体 - 环境变量模板
# 用法：复制为 .env 后填写真实值；容器/CloudBase 部署时，
#       将对应变量配置到平台的环境变量面板（无需 .env 文件）。
# 注意：POSTGRES_CONNECTION_STRING / DASHSCOPE_API_KEY 等
#       属敏感信息，切勿提交进 git（.env 已在 .gitignore 中）。
# ============================================================

# ===== 大模型（通义千问 DashScope，OpenAI 兼容模式）=====
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=你的DashScope密钥
DASHSCOPE_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
# Qwen3 推理模型 thinking 模式开关（默认关闭，避免 <think> 标签泄漏）
LLM_ENABLE_THINKING=false
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ===== 服务 =====
# CloudBase 云托管会自动注入 PORT，无需手动设置；本地/compose 默认 8123
APP_PORT=8123
DEBUG=false
# API 鉴权：逗号分隔的 Key 列表；云端自己用也建议设一个，如 API_KEYS=sk-xxxx
API_KEYS=
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_LENGTH=4000
# CORS：云端需加入前端域名（H5/Web），如 https://h5.your-domain.com
CORS_ORIGINS=https://你的前端域名

# ===== Agent =====
AGENT_MAX_STEPS=8

# ===== 搜索 API =====
SEARCH_API_KEY=

# ===== 记忆存储（file | postgres）=====
MEMORY_DIR=./data/memory
MEMORY_STORE_TYPE=postgres
MEMORY_TABLE_NAME=message_store

# ===== MCP / 工具 =====
AMAP_MAPS_API_KEY=
PEXELS_API_KEY=

# ===== RAG 知识库 =====
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=你的DashScope密钥（可与上面相同）
VECTOR_STORE_TYPE=postgres
# ⚠️ 腾讯云 PostgreSQL 必须带 sslmode=require，且先在目标库执行 CREATE EXTENSION vector;
POSTGRES_CONNECTION_STRING=postgresql://用户名:密码@你的PG地址:5432/xianzhi?sslmode=require
POSTGRES_COLLECTION=xianzhi_knowledge
EMBEDDING_LOCAL_FALLBACK=true
RAG_K=2
RAG_SEARCH_CACHE_TTL=60

# ===== 可观测性（可选）=====
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=xianzhi-agent
LANGSMITH_TRACING=false

# ===== 微信小程序登录（如用到）=====
WECHAT_APPID=
WECHAT_SECRET=
