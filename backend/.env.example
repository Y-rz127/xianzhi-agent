# ============================================================
# 先知智能体 · 环境变量模板
# 这里只列配置项、不留数值：留空即用代码默认值（见 app/core/config/settings.py）。
# 真实数值只写入 backend/.env（已在 .gitignore）；容器/CloudBase 部署时改为
# 在平台环境变量面板配置同名变量，无需 .env 文件。
# 与 .env 保持同序同名，方便对照。
# ============================================================

# ===== 大模型（DashScope，OpenAI 兼容模式）=====
DASHSCOPE_BASE_URL=  # 兼容模式端点，例：https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=  # DashScope 密钥（必填）
DASHSCOPE_MODEL=  # 主模型：问答/断事/命盘终审
LLM_ENABLE_THINKING=  # 主模型思考模式开关
LLM_TEMPERATURE=  # 采样温度 0-2；不接受该参数的模型见下一项
LLM_NO_TEMPERATURE_MODELS=  # 不接受 temperature 的模型前缀（逗号分隔）；漏填会 400
LLM_TIMEOUT=  # 单次调用超时（秒）：思考型模型整盘实测可达 135s
LLM_STREAM_CHUNK_TIMEOUT=  # 两 chunk 间最长静默（秒）；思考期不吐字，留空/0=关闭保护
LLM_MAX_RETRIES=  # 失败重试次数

# ===== 子模型（意图拆解 / 审核 / 子应用）=====
DECOMPOSE_MODEL=  # 意图拆解：轻量快速，留空复用主模型
DECOMPOSE_ENABLE_THINKING=  # 思考开关必须按模型真实能力填，写错该层每轮静默失败
REVIEWER_MODEL=  # Reviewer 深审：需支持 JSON 输出，留空复用主模型
REVIEWER_ENABLE_THINKING=
SUB_APP_MODEL=  # 塔罗/紫微/六爻/合婚/报告/K线批注，留空复用主模型
SUB_APP_ENABLE_THINKING=
LLM_CHAIN_PROBE_ENABLED=  # 启动后后台探测降级链各模型可用性

# ===== 语音（ASR / TTS）=====
ASR_MODEL=  # 语音输入：HTTP 转写，例：qwen-audio-3.1-asr-flash（-streaming 是 WS 接口，不适用）
TTS_MODEL=  # 朗读合成，例：qwen-audio-3.1-tts-flash（端点与 ASR 不同）
TTS_VOICE=  # 系统音色名，例：longanhuan_v3.1
TTS_TIMEOUT=  # 单次合成超时（秒）

# ===== LLM 背压与熔断（DashScope 配额保护）=====
LLM_MAX_CONCURRENCY=  # 全模型共享并发上限
LLM_QUEUE_TIMEOUT=  # 排队超时（秒），超时抛「繁忙」
LLM_CIRCUIT_FAILURE_THRESHOLD=  # 连续失败达此数触发熔断
LLM_CIRCUIT_OPEN_SECONDS=  # 熔断冷却（秒），之后半开放行一个试探
LLM_PRICE_MAP=  # 成本表 JSON（元/百万 token，前缀最长匹配）；留空=只统计 token 不折算金额

# ===== 服务（HTTP）=====
APP_ENV=  # dev / production；production 会强制关闭调试与 LangSmith
APP_PORT=  # 监听端口，本地/compose 用 8123；CloudBase 会注入 PORT
APP_VERSION=  # 版本标识：部署时注入 git sha/tag，灰度时核对 /api/health/live
DEBUG=  # 调试日志；生产强制关闭
RELOAD=  # 热重载：仅本地开发，开启会强制单进程
API_KEYS=  # 逗号分隔的机器调用 Key（Header: X-API-Key）；浏览器端走短时令牌
CORS_ORIGINS=  # 允许的前端源（逗号分隔），云端需加 H5/Web 域名
RATE_LIMIT_PER_MINUTE=  # 单 IP 每分钟请求上限，0=不限
MAX_MESSAGE_LENGTH=  # 单条消息最大字符数，超出直接拒绝
TRUST_PROXY_HEADERS=  # 经可信代理(CDN/CLB)时置 true，从 X-Forwarded-For 取真实 IP

# ===== Agent（编排 / 会话锁 / WS）=====
AGENT_MAX_STEPS=  # 单轮最大步数，防无限循环
CHECKPOINTER_ENABLED=  # LangGraph 断点恢复，PG 不可用自动降级
CHAT_TURN_BUDGET=  # 单轮总时限（秒）：工作流/ReAct/闲聊共用，耗尽则跳过剩余阶段
WORKFLOW_DECOMPOSE_TIMEOUT=  # 拆解阶段上限（秒），实际取 min(本值, 剩余预算)
WORKFLOW_GENERATE_TIMEOUT=  # 生成阶段上限（秒）
WORKFLOW_REVIEW_TIMEOUT=  # 审核阶段上限（秒）
WORKFLOW_REPAIR_TIMEOUT=  # 修复阶段上限（秒）
WORKFLOW_LLM_TIMEOUT=  # 无预算场景（脚本/测试）单次 LLM 超时（秒）
SESSION_LOCK_TTL_SECONDS=  # 会话锁租约（秒），持有期自动续租，崩溃后最多这么久解锁
SESSION_LOCK_WAIT_TIMEOUT=  # 同会话排队等锁上限（秒），超时提示"上一轮仍在生成"；0=无限等
WS_MAX_PARALLEL_SESSIONS=  # 单条 WS 连接可并发生成的会话数（见 docs/architecture/ws-multiplex.md）

# ===== 并发与连接池 =====
THREAD_POOL_SIZE=  # 同步 workflow/LLM 调用专用线程池（默认池太小，长会话会饿死）
PG_POOL_MIN_SIZE=
PG_POOL_MAX_SIZE=
PG_POOL_TIMEOUT=  # 连接池借出超时（秒），超池最多等这么久
REPORT_TASK_WORKERS=  # 报告后台 worker 数（PDF 渲染 CPU 密集，别调大）

# ===== 存储：PostgreSQL / Redis =====
POSTGRES_CONNECTION_STRING=  # 例：postgresql://用户名:密码@localhost:5433/xianzhi（须先 CREATE EXTENSION vector;）
TEST_POSTGRES_CONNECTION_STRING=  # pytest 专用：库名必须以 _test 结尾，CONFTEST 才会改道；运行时不读
POSTGRES_COLLECTION=  # 知识库表名
REDIS_URL=  # 限流/会话锁共享状态，例：redis://localhost:6379/0；留空降级为进程内存（生产必须配）
# DATA_DIR=  # 数据根目录；默认 backend/data（绝对路径），填相对路径会随启动目录变化

# ===== 记忆存储（file | postgres）=====
MEMORY_STORE_TYPE=
MEMORY_DIR=  # store_type=file 时的落盘目录
MEMORY_TABLE_NAME=

# ===== RAG 知识库 =====
EMBEDDING_MODEL=  # DashScope embedding 模型，例：text-embedding-v2 / v3 / v4
EMBEDDING_API_KEY=  # 可与 DASHSCOPE_API_KEY 相同
EMBEDDING_LOCAL_MODEL=  # DashScope 不可用时的本地回退模型（需 pip install sentence-transformers）
EMBEDDING_LOCAL_FALLBACK=
EMBEDDING_BATCH_SIZE=  # 单次 embedding 条数上限（部分 flash 系大批量会挂死而不报错）
EMBEDDING_MAX_CHARS_PER_BATCH=  # 单次 embedding 总字符上限
VECTOR_STORE_TYPE=  # postgres | file
VECTOR_DB_DIR=  # store_type=file 时的落盘目录
RAG_K=  # 检索条数
RAG_MMR_LAMBDA=  # MMR 多样性权重
RAG_MIN_OVERLAP=  # rerank 关键词覆盖率下限，低于即丢弃（宁缺毋滥）
RAG_SEARCH_CACHE_TTL=  # 检索结果缓存（秒），避免重复调 embedding
RAG_INIT_ENABLED=  # 启动时初始化知识库
# RAG_DISTANCE_THRESHOLD=  # 向量距离阈值；不填=不做该过滤

# ===== 搜索与外部工具 =====
SEARCH_API_KEY=  # 联网搜索
WEB_SCRAPE_ENABLED=  # 网页抓取工具：仅允许公网 http/https，禁私网/metadata
WEB_SCRAPE_ALLOWED_HOSTS=  # 抓取域名白名单（逗号分隔）；留空=任意公网域名
AMAP_MAPS_API_KEY=  # 高德 MCP
AMAP_MCP_VERSION=  # 固定 MCP npm 包版本，升级前先在测试环境验证
PEXELS_API_KEY=

# ===== 可观测性（仅开发环境）=====
LANGSMITH_API_KEY=  # trace 含生辰/问答原文，APP_ENV=production 时代码强制关闭
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# ===== 隐私与数据治理 =====
LOG_LLM_CONTENT=  # 是否把用户原文/回答写进日志；排查时临时开
MESSAGE_RETENTION_DAYS=  # 用户消息/命盘数据保留天数，0=不自动清理；生产建议 90
CHECKPOINT_RETENTION_HOURS=  # 异常中断残留 checkpoint 清理时长（小时），0=不清理

# ===== 付费接口日配额（0=不限；登录按账号、游客按 IP）=====
PAID_QUOTA_REPORT_DAILY=
PAID_QUOTA_ASR_DAILY=
PAID_QUOTA_TTS_DAILY=
PAID_QUOTA_INTERPRET_DAILY=
PAID_QUOTA_GUEST_DAILY=

# ===== 微信小程序登录 =====
WECHAT_APPID=
WECHAT_SECRET=

# ===== 管理后台（首次启动且 data/admin_accounts.json 不存在时创建默认管理员）=====
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=  # 短时令牌签名密钥（生产必填，多副本必须一致）：python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_TOKEN_TTL_SECONDS=  # 令牌有效期（秒）
ADMIN_LOGIN_IP_LIMIT=  # 单 IP 每分钟登录尝试上限，0=关闭
ADMIN_LOGIN_MAX_FAILS=  # 同账号窗口内连续失败达此数后锁定，0=关闭
ADMIN_LOGIN_FAIL_WINDOW=  # 失败计数窗口（秒）
ADMIN_LOGIN_LOCK_SECONDS=  # 锁定时长（秒）
