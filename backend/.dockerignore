# 敏感配置（禁止打进镜像）
.env
.env.local
*.secret

# 运行时数据
data/
logs/
*.log

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.coverage
htmlcov/

# 测试
tests/
.pytest_cache/
.test_tmp/

# 本地工具（locust / iztro oracle 生成器的 node_modules 体积大且运行时不需要）
scripts/node_modules/

# 文档（运行时不需要）
*.md
