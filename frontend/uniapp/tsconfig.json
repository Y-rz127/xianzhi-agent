{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    // 历史坑：曾锁定 TS 4.9.5，moduleResolution "bundler" 不被识别导致 vue-tsc 报 TS5070；
    // 已升级 typescript ^5.5 / vue-tsc ^2（与 frontend/ 对齐），恢复 bundler 解析。
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noImplicitThis": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    // 历史坑：本文件曾缺 noEmit 且开着 sourceMap —— 于是 `vue-tsc -b`
    // （而不是 package.json 里配的 `vue-tsc --noEmit`）会把 .js / .js.map
    // emit 回 src/ 与 shared/，一次跑出 86 个产物文件躺在源码目录里。
    // 那些 .js 与同名 .ts 并存，import 解析可能命中陈旧产物 ⇒ 改了代码却不生效。
    // 类型检查请统一走 `npm run type-check`；noEmit 是第二道锁。
    "sourceMap": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["@dcloudio/types"],
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
