# Web 端本地开发：直连云端后端（与小程序同款方案，web 端不单独部署）
# 用法：复制本文件为 .env.local（已被 gitignore，不会提交），并把地址换成你的真实云端地址
#
#   cp .env.development.example .env.local
#
# 云端地址 = CloudBase 服务「公网访问地址」+ /api 后缀
# 例：VITE_API_BASE=https://xianzhi-agent-xxxxxx.ap-shanghai.run.tcloudbase.com/api
VITE_API_BASE=https://替换为你的云端访问域名/api
